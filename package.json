{
  "name": "@open-ccw/scratch-render",
  "version": "9.9.17",
  "description": "WebGL Renderer for Scratch 3.0 patched for Gandi IDE",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/open-ccw/scratch-render",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/open-ccw/scratch-render.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/scratch-render.umd.js",
  "module": "./dist/scratch-render.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/scratch-render.mjs",
      "require": "./dist/scratch-render.umd.js"
    }
  },
  "browser": "./dist/scratch-render.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  },
  "dependencies": {
    "events": "^3.3.0",
    "hull.js": "^0.2.1",
    "scratch-svg-renderer": "^3.1.19",
    "twgl.js": "5.3"
  }
}
